# Скопируй в .env и заполни. .env в git не попадает.
#
# На работе: llama.cpp (llama-server, батники в scripts\windows), ключ любой.
# Дома: polza.ai — только пример и синтетика, реальный реестр туда не отправляем.

# --- Эмбеддинги bge-m3 (обязательно) ---
# работа: start-embeddings.bat
EMB_BASE_URL=http://127.0.0.1:8081/v1
EMB_API_KEY=
EMB_MODEL=bge-m3
# дома:
# EMB_BASE_URL=https://api.polza.ai/api/v1
# EMB_API_KEY=<ключ polza>
# EMB_MODEL=baai/bge-m3

# --- LLM-судья для спорных случаев (необязательно) ---
# работа: start-judge.bat (там уже --reasoning off)
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=
LLM_MODEL=qwen3.6-35b-a3b
# дома: у qwen3.6 на polza рассуждения не выключаются, только «low»,
# и им нужен запас токенов на ответ:
# LLM_BASE_URL=https://api.polza.ai/api/v1
# LLM_API_KEY=<ключ polza>
# LLM_MODEL=qwen/qwen3.6-35b-a3b
# LLM_EXTRA_BODY={"reasoning": {"effort": "low"}}
# PPU_LLM_MAX_TOKENS=4000

# --- Реранкер (не используется в вердикте) ---
# На синтетике мерил «та же тема», а не «та же идея», поэтому из вердикта убран.
# Нужен только чтобы перепроверить это на реальных данных: ppu.evaluate --rerank-url
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=

# --- Веб-интерфейс (необязательно) ---
# PPU_INDEX=data/index
# PPU_EMB_CACHE=data/emb_cache.sqlite
